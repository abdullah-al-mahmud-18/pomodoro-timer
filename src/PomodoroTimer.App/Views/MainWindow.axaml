<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PomodoroTimer.App.ViewModels"
        x:Class="PomodoroTimer.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Pomodoro Timer"
        Icon="avares://PomodoroTimer.App/Assets/hourglass.png"
        Width="980" Height="640"
        MinWidth="760" MinHeight="520">

    <!-- Dashboard tables: every header and row uses the same fixed ColumnDefinitions="200,120,120,120",
         so columns line up regardless of text length. -->
    <Window.Styles>
        <!-- Top nav: all three pages always reachable; the current page's button is highlighted. -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="#2A2A3A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A3A4E" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}" />
        </Style>
        <Style Selector="Grid.dashColumns > TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.dashColumns > TextBlock.value">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="Grid.dashHeader > TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="Gray" />
        </Style>
        <Style Selector="ItemsControl.dashRows ContentPresenter:nth-child(2n)">
            <Setter Property="Background" Value="#0DFFFFFF" />
        </Style>
    </Window.Styles>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:DashboardRowViewModel" x:DataType="vm:DashboardRowViewModel">
            <Grid Classes="dashColumns" ColumnDefinitions="200,120,120,120" Margin="16,8">
                <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="Medium" />
                <TextBlock Grid.Column="1" Classes="value" Text="{Binding WorkDisplay}" />
                <TextBlock Grid.Column="2" Classes="value" Text="{Binding StudyDisplay}" />
                <TextBlock Grid.Column="3" Classes="value" Text="{Binding BreakDisplay}" />
            </Grid>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid Margin="16" RowDefinitions="Auto,*">

        <!-- Top nav bar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="Pomodoro Timer" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                <!-- Sync status: small and unobtrusive, with Retry / Sign in when there's something to do. -->
                <StackPanel DataContext="{Binding Sync}" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" ToolTip.Tip="{Binding Detail}"
                               FontSize="12" Foreground="Gray" VerticalAlignment="Center" />
                    <Button Content="{Binding ActionText}" Command="{Binding ActionCommand}"
                            IsVisible="{Binding IsActionVisible}"
                            FontSize="12" Padding="8,2" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Classes="nav" Classes.active="{Binding IsTimerViewActive}"
                        Content="Timer" Command="{Binding ShowTimerCommand}" />
                <Button Classes="nav" Classes.active="{Binding IsDashboardViewActive}"
                        Content="Dashboard" Command="{Binding ShowDashboardCommand}" />
                <Button Classes="nav" Classes.active="{Binding IsHistoryViewActive}"
                        Content="History" Command="{Binding ShowHistoryCommand}" />
            </StackPanel>
        </Grid>

        <!-- TIMER / STOPWATCH VIEW -->
        <ScrollViewer Grid.Row="1" IsVisible="{Binding IsTimerViewActive}"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" MaxWidth="420" HorizontalAlignment="Center">

                <!-- Mode toggle -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <RadioButton Content="Timer" GroupName="Mode"
                                 IsChecked="{Binding IsTimerMode}"
                                 IsEnabled="{Binding IsConfiguring}" />
                    <RadioButton Content="Stopwatch" GroupName="Mode"
                                 IsChecked="{Binding IsStopwatchMode}"
                                 IsEnabled="{Binding IsConfiguring}" />
                </StackPanel>

                <!-- Category (Work / Study / Break) -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Mode" FontSize="12" Foreground="Gray" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <RadioButton Content="Work" GroupName="Category"
                                     IsChecked="{Binding IsWorkCategory}"
                                     IsEnabled="{Binding IsConfiguring}" />
                        <RadioButton Content="Study" GroupName="Category"
                                     IsChecked="{Binding IsStudyCategory}"
                                     IsEnabled="{Binding IsConfiguring}" />
                        <RadioButton Content="Break" GroupName="Category"
                                     IsChecked="{Binding IsBreakCategory}"
                                     IsEnabled="{Binding IsConfiguring}" />
                    </StackPanel>
                </StackPanel>

                <!-- Name -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Name" FontSize="12" Foreground="Gray" />
                    <TextBox Text="{Binding SessionName}"
                             Watermark="e.g. Deep work"
                             IsEnabled="{Binding IsConfiguring}" />
                </StackPanel>

                <!-- Custom duration (timer mode only) -->
                <StackPanel Spacing="4" IsVisible="{Binding IsTimerMode}">
                    <TextBlock Text="Duration" FontSize="12" Foreground="Gray" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBox Classes="digitsOnly" Text="{Binding HoursText}" Width="56" HorizontalContentAlignment="Center"
                                  IsEnabled="{Binding IsConfiguring}" />
                        <TextBlock Text="h" VerticalAlignment="Center" />
                        <TextBox Classes="digitsOnly" Text="{Binding MinutesText}" Width="56" HorizontalContentAlignment="Center"
                                  IsEnabled="{Binding IsConfiguring}" />
                        <TextBlock Text="m" VerticalAlignment="Center" />
                        <TextBox Classes="digitsOnly" Text="{Binding SecondsText}" Width="56" HorizontalContentAlignment="Center"
                                  IsEnabled="{Binding IsConfiguring}" />
                        <TextBlock Text="s" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="IndianRed"
                           TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <!-- Big time display -->
                <Border Background="#1E1E2E" CornerRadius="12" Padding="24" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding TimeDisplay}"
                                   FontSize="56" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   FontFamily="Consolas,Cascadia Mono,monospace" />
                        <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100"
                                     Height="6" Width="260"
                                     IsVisible="{Binding IsTimerMode}" />
                    </StackPanel>
                </Border>

                <!-- Controls -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Start" Command="{Binding StartCommand}" Classes="accent" />
                    <Button Content="Pause" Command="{Binding PauseCommand}" />
                    <Button Content="Resume" Command="{Binding ResumeCommand}" />
                    <Button Content="Stop" Command="{Binding StopCommand}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- HISTORY VIEW -->
        <Grid Grid.Row="1" IsVisible="{Binding IsHistoryViewActive}">
            <DockPanel DataContext="{Binding History}">
                <TextBlock DockPanel.Dock="Top" Text="History" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />

                <!-- Filters -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Type" FontSize="12" Foreground="Gray" />
                        <ComboBox ItemsSource="{Binding TypeOptions}"
                                  SelectedItem="{Binding SelectedType}"
                                  Width="140" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Mode" FontSize="12" Foreground="Gray" />
                        <ComboBox ItemsSource="{Binding ModeOptions}"
                                  SelectedItem="{Binding SelectedMode}"
                                  Width="140" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Session" FontSize="12" Foreground="Gray" />
                        <ComboBox ItemsSource="{Binding StatusOptions}"
                                  SelectedItem="{Binding SelectedStatus}"
                                  Width="140" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Period" FontSize="12" Foreground="Gray" />
                        <ComboBox ItemsSource="{Binding PeriodOptions}"
                                  SelectedItem="{Binding SelectedPeriod}"
                                  Width="140" />
                    </StackPanel>
                    <Button Content="Delete Filtered Data"
                            Command="{Binding DeleteFilteredCommand}"
                            VerticalAlignment="Bottom"
                            Background="#8B2E2E" Foreground="White" Padding="12,6" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Sessions}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SessionItemViewModel">
                            <Border Padding="8" Margin="0,2" Background="#14000000" CornerRadius="6">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontWeight="Medium" />
                                    <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                            ToolTip.Tip="Delete"
                                            Command="{Binding $parent[ListBox].((vm:HistoryViewModel)DataContext).DeleteSessionCommand}"
                                            CommandParameter="{Binding}"
                                            Padding="6" VerticalAlignment="Center">
                                        <!-- Trash bin icon (Material Design "delete") -->
                                        <PathIcon Width="14" Height="14"
                                                  Data="M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19V4Z" />
                                    </Button>
                                    <TextBlock Grid.Row="1" Grid.Column="0" FontSize="11" Foreground="Gray">
                                        <Run Text="{Binding ModeDisplay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding CategoryDisplay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding DurationDisplay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding StatusDisplay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding StartedAtDisplay}" />
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- "Are you sure?" overlay for Delete Filtered Data; covers the page so nothing else can be clicked. -->
            <Border DataContext="{Binding History}"
                    IsVisible="{Binding IsConfirmingDeleteFiltered}"
                    Background="#B3000000">
                <Border Background="#1E1E2E" CornerRadius="8" Padding="24"
                        MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Are you sure?" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="{Binding DeleteFilteredPrompt}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="Cancel"
                                    Command="{Binding CancelDeleteFilteredCommand}"
                                    Padding="12,6" />
                            <Button Content="Delete"
                                    Command="{Binding ConfirmDeleteFilteredCommand}"
                                    Background="#8B2E2E" Foreground="White" Padding="12,6" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- DASHBOARD VIEW -->
        <ScrollViewer Grid.Row="1" IsVisible="{Binding IsDashboardViewActive}">
            <StackPanel DataContext="{Binding Dashboard}" Spacing="24" HorizontalAlignment="Center">

                <StackPanel Spacing="8">
                    <TextBlock Text="Today" FontSize="18" FontWeight="Bold" />
                    <Border BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                        <StackPanel>
                            <Border Background="#1E1E2E" Padding="16,8">
                                <Grid Classes="dashColumns dashHeader" ColumnDefinitions="200,120,120,120">
                                    <TextBlock Grid.Column="0" Text="Period" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="Work" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="Study" />
                                    <TextBlock Grid.Column="3" Classes="value" Text="Break" />
                                </Grid>
                            </Border>
                            <ItemsControl Classes="dashRows" ItemsSource="{Binding TodayRows}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Totals" FontSize="18" FontWeight="Bold" />
                    <Border BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                        <StackPanel>
                            <Border Background="#1E1E2E" Padding="16,8">
                                <Grid Classes="dashColumns dashHeader" ColumnDefinitions="200,120,120,120">
                                    <TextBlock Grid.Column="0" Text="Period" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="Work" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="Study" />
                                    <TextBlock Grid.Column="3" Classes="value" Text="Break" />
                                </Grid>
                            </Border>
                            <ItemsControl Classes="dashRows" ItemsSource="{Binding TotalRows}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Daily averages" FontSize="18" FontWeight="Bold" />
                    <Border BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                        <StackPanel>
                            <Border Background="#1E1E2E" Padding="16,8">
                                <Grid Classes="dashColumns dashHeader" ColumnDefinitions="200,120,120,120">
                                    <TextBlock Grid.Column="0" Text="Period" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="Work / day" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="Study / day" />
                                    <TextBlock Grid.Column="3" Classes="value" Text="Break / day" />
                                </Grid>
                            </Border>
                            <ItemsControl Classes="dashRows" ItemsSource="{Binding AverageRows}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Covers the window while startup/shutdown sync runs (and shows startup errors). Toggled from code-behind. -->
        <Border x:Name="BusyOverlay" Grid.RowSpan="2" Margin="-16" Background="#F2121218" IsVisible="False">
            <TextBlock x:Name="BusyOverlayText" Text="Syncing…" FontSize="18"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

    </Grid>

</Window>
