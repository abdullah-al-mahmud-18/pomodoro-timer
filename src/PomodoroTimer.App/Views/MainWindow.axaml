<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PomodoroTimer.App.ViewModels"
        x:Class="PomodoroTimer.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Pomodoro Timer"
        Width="980" Height="640"
        MinWidth="760" MinHeight="520">

    <Grid ColumnDefinitions="1.1*,2,1*" Margin="16">

        <!-- LEFT: Timer / Stopwatch controls -->
        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="16">

                <TextBlock Text="Pomodoro Timer" FontSize="22" FontWeight="Bold" />

                <!-- Mode toggle -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <RadioButton Content="Timer" GroupName="Mode"
                                 IsChecked="{Binding IsTimerMode}"
                                 IsEnabled="{Binding IsConfiguring}" />
                    <RadioButton Content="Stopwatch" GroupName="Mode"
                                 IsChecked="{Binding IsStopwatchMode}"
                                 IsEnabled="{Binding IsConfiguring}" />
                </StackPanel>

                <!-- Name -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Name" FontSize="12" Foreground="Gray" />
                    <TextBox Text="{Binding SessionName}"
                             Watermark="e.g. Deep work"
                             IsEnabled="{Binding IsConfiguring}" />
                </StackPanel>

                <!-- Custom duration (timer mode only) -->
                <StackPanel Spacing="4" IsVisible="{Binding IsTimerMode}">
                    <TextBlock Text="Duration" FontSize="12" Foreground="Gray" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBox Text="{Binding HoursText}" Width="56" HorizontalContentAlignment="Center"
                                  IsEnabled="{Binding IsConfiguring}" />
                        <TextBlock Text="h" VerticalAlignment="Center" />
                        <TextBox Text="{Binding MinutesText}" Width="56" HorizontalContentAlignment="Center"
                                  IsEnabled="{Binding IsConfiguring}" />
                        <TextBlock Text="m" VerticalAlignment="Center" />
                        <TextBox Text="{Binding SecondsText}" Width="56" HorizontalContentAlignment="Center"
                                  IsEnabled="{Binding IsConfiguring}" />
                        <TextBlock Text="s" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="IndianRed"
                           TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <!-- Big time display -->
                <Border Background="#1E1E2E" CornerRadius="12" Padding="24" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding TimeDisplay}"
                                   FontSize="56" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   FontFamily="Consolas,Cascadia Mono,monospace" />
                        <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100"
                                     Height="6" Width="260"
                                     IsVisible="{Binding IsTimerMode}" />
                    </StackPanel>
                </Border>

                <!-- Controls -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Start" Command="{Binding StartCommand}" Classes="accent" />
                    <Button Content="Pause" Command="{Binding PauseCommand}" IsVisible="{Binding IsTimerMode}" />
                    <Button Content="Resume" Command="{Binding ResumeCommand}" />
                    <Button Content="Stop" Command="{Binding StopCommand}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Divider -->
        <Rectangle Grid.Column="1" Fill="#33000000" Width="1" HorizontalAlignment="Center" />

        <!-- RIGHT: History -->
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="History" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />

            <ListBox ItemsSource="{Binding History}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionItemViewModel">
                        <Border Padding="8" Margin="0,2" Background="#14000000" CornerRadius="6">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontWeight="Medium" />
                                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                        Content="✕"
                                        Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).DeleteSessionCommand}"
                                        CommandParameter="{Binding}"
                                        Padding="6,2" VerticalAlignment="Top" />
                                <TextBlock Grid.Row="1" Grid.Column="0" FontSize="11" Foreground="Gray">
                                    <Run Text="{Binding ModeDisplay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding DurationDisplay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding StatusDisplay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding StartedAtDisplay}" />
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

    </Grid>

</Window>
